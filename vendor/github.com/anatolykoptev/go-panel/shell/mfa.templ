package shell

templ MFAPage(basePath string, errMsg string) {
<!DOCTYPE html>
<html lang="en" class={ themeClass("") }>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Two-Factor Authentication</title>
    <link rel="stylesheet" href={ basePath + "/static/pm7.css" }/>
<style>
				:root{
					--pm7-background:#060b18;--pm7-foreground:#e8edf5;--pm7-muted:#131c31;
					--pm7-muted-foreground:#7b8ba8;--pm7-border:#1e2d4a;--pm7-input:#0c1222;
					--pm7-primary:#3b82f6;--pm7-primary-hover:#2563eb;--pm7-primary-foreground:#fff;
					--pm7-radius:.625rem;
					--bg-deep:#060b18;--bg-surface:#131c31;--accent:#3b82f6;
					--accent-glow:rgba(59,130,246,.15);--text-primary:#e8edf5;
					--text-secondary:#7b8ba8;--border:#1e2d4a;
					--font-sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
				}
				*{box-sizing:border-box}
				body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-deep);color:var(--text-primary);font-family:var(--font-sans);font-size:.875rem;padding:1.5rem}
				.login-shell{width:100%;max-width:22rem}
				.login-card{width:100%;padding:2rem;background:var(--bg-surface);border:1px solid var(--border);border-radius:.75rem}
				.login-title{margin:0 0 1.5rem;font-size:1.125rem;font-weight:700;color:var(--text-primary);text-align:center;letter-spacing:.01em}
				.login-error{margin-bottom:1rem;padding:.5rem .75rem;border-radius:.375rem;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.35);color:#fca5a5;font-size:.8125rem;text-align:center}
				.login-field{margin-bottom:1rem}
				.login-field label{display:block;margin-bottom:.375rem;font-size:.8125rem;color:var(--text-secondary)}
				.login-form .pm7-input{width:100%;padding:.5rem .75rem;background:var(--bg-deep);border:1px solid var(--border);border-radius:.5rem;color:var(--text-primary);font-size:.875rem;outline:none;transition:border-color .15s,box-shadow .15s}
				.login-form .pm7-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-glow)}
				.pw-wrap{position:relative}
				.pw-wrap .pm7-input{padding-right:2.75rem}
				.pw-toggle{position:absolute;top:0;right:0;height:100%;width:2.75rem;display:flex;align-items:center;justify-content:center;background:none;border:none;color:var(--text-secondary);cursor:pointer;padding:0}
				.pw-toggle:hover{color:var(--text-primary)}
				.pw-toggle:focus-visible{outline:2px solid var(--accent);outline-offset:-2px;border-radius:.5rem}
				.pw-toggle svg{width:1.125rem;height:1.125rem;display:block}
				.pw-toggle svg[hidden]{display:none}
				.login-submit{width:100%;margin-top:.25rem;padding:.625rem;background:var(--accent);color:#fff;border:none;border-radius:.5rem;font-size:.875rem;font-weight:600;cursor:pointer;transition:background-color .15s}
				.login-submit:hover{background:var(--pm7-primary-hover)}
			</style>
</head>
<body>
    <main class="login-shell">
        <div class="pm7-card login-card">
            <div class="pm7-card-content">
                <h1 class="login-title">Two-Factor Authentication</h1>
                if errMsg != "" {
                    <div class="login-error" role="alert">{ errMsg }</div>
                }
                <form method="POST" action={ templ.SafeURL(basePath + "/login") } class="login-form">
                    <div class="login-field">
                        <label for="code">Authentication code or recovery code</label>
                        <input id="code" name="code" type="text" autocomplete="one-time-code" class="pm7-input" autofocus/>
                    </div>
                    <button type="submit" class="pm7-button pm7-button--primary login-submit">Verify</button>
                </form>
            </div>
        </div>
    </main>
    <script src={ basePath + "/static/pm7.js" }></script>
</body>
</html>
}
