package shell

import (
	"context"

	"github.com/anatolykoptev/go-panel/shell/internal/assets"
)

// NavItem is a sidebar navigation entry registered by a Resource.
//
// NavItem contains func fields (Badge, Visible) and is therefore NOT comparable
// — do not use == on NavItem values or as map keys. (F5)
type NavItem struct {
	ID     string
	Label  string
	Icon   string
	URL    string
	Active bool
	Group  string // non-empty = this item is a group header, not a link

	// Tooltip is the text shown as a popover when the sidebar is in collapsed
	// (icon-rail) mode. Empty string falls back to Label — zero-value safe,
	// existing callers are unaffected.
	// Also emitted as aria-label on the anchor for screen-reader wayfinding.
	Tooltip string

	// Badge is an optional closure returning a short label/count pill shown
	// next to the nav item (e.g. "12", "new"). Called once per page render —
	// wrap with shell.CachedBadge to avoid a per-render DB query.
	// nil = no badge (zero-value safe; existing callers are unaffected).
	// The returned string is HTML-escaped by templ; do NOT pass templ.Raw.
	Badge func(ctx context.Context) string

	// Visible is a cosmetic predicate evaluated in the RESOURCE layer
	// (navItemsFor) before the nav list reaches Layout. nil = always visible.
	// The shell template renders a pre-filtered list and NEVER calls Visible.
	//
	// SECURITY: Visible is NEVER a route gate. An item hidden by Visible is
	// still reachable by direct URL. Use Resource.RequiredRole to enforce
	// access on the route itself.
	Visible func(ctx context.Context) bool

	// RequiredRole is metadata copied from Resource.RequiredRole at Register
	// time. Used by navItemsFor (resource layer) to derive nav-hiding from the
	// same role used by the route gate — NEVER evaluated by the shell template.
	// Zero value = no role gate (backward-compat).
	RequiredRole string

	// Children is an optional list of one-level child navigation items.
	// nil or empty means the item is a leaf — current behaviour, backward-compat.
	// Children-of-children are ignored: one level only (rule-of-three YAGNI).
	// NavItem contains func fields and is therefore NOT comparable;
	// do not use == on NavItem values or slice elements for identity. (F5)
	Children []NavItem
}

// tooltipOf returns item.Tooltip when non-empty, otherwise item.Label.
// Used for aria-label and the collapsed-mode .sidebar-tooltip span.
func tooltipOf(item NavItem) string {
	if item.Tooltip != "" {
		return item.Tooltip
	}
	return item.Label
}

// avatarInitial returns the first rune of name as a string, or "?" when empty.
// Used to render the avatar circle in the profile block. Safe for UTF-8 names.
func avatarInitial(name string) string {
	for _, r := range name {
		return string(r)
	}
	return "?"
}

// profileLogoutURL returns p.LogoutURL if set, otherwise the conventional default.
func profileLogoutURL(p ProfileConfig) string {
	if p.LogoutURL != "" {
		return p.LogoutURL
	}
	return "/admin/logout"
}

// hasActiveChild reports whether any direct child of item is active.
// Used server-side to emit data-has-active-child on parent submenu wrappers,
// so JS always keeps parents of the current-page item expanded regardless of
// the sb-s cookie — mirrors the group-level guard in toNavGroups.
func hasActiveChild(item NavItem) bool {
	for _, child := range item.Children {
		if child.Active {
			return true
		}
	}
	return false
}

// navGrouped pairs a nav group header with the items that follow it.
// An empty Label ("") represents items that appear before any group header.
type navGrouped struct {
	Label     string
	Collapsed bool
	Items     []NavItem
}

// toNavGroups converts a flat []NavItem (group-header NavItem followed by its
// member NavItems) into a []navGrouped for nested sidebar-group rendering.
// Items appearing before any group header go into an anonymous entry (Label="")
// that is not collapsible — preserves backward compat with navs that skip groups.
// collapsedGroups is ChromeState.CollapsedGroups; nil map is safe (treated as empty).
//
// A group that contains the current active item is always expanded regardless of
// the sb-g cookie: hiding the active wayfinding indicator is disorienting.
func toNavGroups(nav []NavItem, collapsedGroups map[string]bool) []navGrouped {
	var out []navGrouped
	for _, item := range nav {
		if item.Group != "" {
			out = append(out, navGrouped{
				Label:     item.Group,
				Collapsed: collapsedGroups[item.Group],
			})
		} else {
			if len(out) == 0 {
				out = append(out, navGrouped{}) // anonymous pre-group bucket
			}
			out[len(out)-1].Items = append(out[len(out)-1].Items, item)
			// Active item forces its group expanded: collapsed active item hides
			// the current-page wayfinding indicator, which is disorienting.
			if item.Active {
				out[len(out)-1].Collapsed = false
			}
		}
	}
	return out
}

// Layout renders the full admin page chrome: html head, pm7 CSS, sidebar nav,
// and a content slot. Used for non-htmx (full-page) requests.
// For htmx requests, render the content component directly (fragment swap).
//
// New state (sidebar collapse) is threaded via context.Context so this
// signature stays frozen: use shell.ContextWithChrome before calling Render.
templ Layout(title string, nav []NavItem, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230f172a'/><text x='6' y='22' font-size='18' fill='%233b82f6'>⚙</text></svg>"/>
			<link rel="stylesheet" href="/admin/static/pm7.css"/>
			@layoutStyles()
		</head>
		<body>
			<div class="app">
				<aside class={ "sidebar", templ.KV("collapsed", ChromeFromContext(ctx).Collapsed) } id="sidebar">
					<div class="sidebar-header">
						<h1>{ title }</h1>
						<button type="button" class="sidebar-toggle" id="sidebar-toggle" title="Toggle sidebar">&#9776;</button>
					</div>
					<nav class="sidebar-nav">
						for _, group := range toNavGroups(nav, ChromeFromContext(ctx).CollapsedGroups) {
							if group.Label != "" {
								<div class="sidebar-group"
									if group.Collapsed {
										data-collapsed="true"
									}
								>
									<button type="button" class="sidebar-group-label" data-group={ group.Label }
										if group.Collapsed {
											aria-expanded="false"
										} else {
											aria-expanded="true"
										}
									>{ group.Label }</button>
									<div class="sidebar-group-items">
										for _, item := range group.Items {
											@sidebarItem(item)
										}
									</div>
								</div>
							} else {
								for _, item := range group.Items {
									@sidebarItem(item)
								}
							}
						}
					</nav>
					<div class="sidebar-bottom">
						if prof := ChromeFromContext(ctx).Profile; prof.Name != "" {
							// Profile block — multi-user consumers (BcryptTOTPAuth).
							<div class="sidebar-profile">
								<div class="sidebar-profile-avatar" aria-hidden="true">{ avatarInitial(prof.Name) }</div>
								<div class="sidebar-profile-info">
									<div class="sidebar-profile-name">{ prof.Name }</div>
									if prof.Role != "" {
										<div class="sidebar-profile-role">{ prof.Role }</div>
									}
								</div>
							</div>
							if prof.SettingsURL != "" {
								<a class="sidebar-item" href={ templ.SafeURL(prof.SettingsURL) } aria-label="Settings">
									<span class="sidebar-icon">&#x2699;</span>
									<span class="sidebar-label">Settings</span>
									<span class="sidebar-tooltip">Settings</span>
								</a>
							}
							<form method="POST" action={ templ.SafeURL(profileLogoutURL(prof)) } style="margin:0;padding:0;display:block">
								<button type="submit" class="sidebar-item sidebar-item--logout" aria-label="Logout" style="anchor-name: --nav-logout">
									<span class="sidebar-icon">&#x2192;</span>
									<span class="sidebar-label">Logout</span>
									<span class="sidebar-tooltip" style="position-anchor: --nav-logout">Logout</span>
								</button>
							</form>
						} else {
							// Bare Logout — backward-compat for single-user consumers (HMACAuth)
							// or when Profile.Name is empty.
							<form method="POST" action="/admin/logout" style="margin:0;padding:0;display:block">
								<button type="submit" class="sidebar-item" aria-label="Logout" style="anchor-name: --nav-logout">
									<span class="sidebar-icon">&#x2192;</span>
									<span class="sidebar-label">Logout</span>
									<span class="sidebar-tooltip" style="position-anchor: --nav-logout">Logout</span>
								</button>
							</form>
						}
					</div>
				</aside>
				<div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>
				<main class="main">
					<button type="button" class="sidebar-mobile-toggle" id="sidebar-mobile-toggle" aria-label="Open navigation">&#9776;</button>
					<div id="content">
						@content
					</div>
				</main>
			</div>
			<script src="/admin/static/htmx.min.js"></script>
			<script src="/admin/static/pm7.js"></script>
			<script src="/admin/static/admin.js" defer></script>
		</body>
	</html>
}

// navLink renders the raw <a> element for a single nav item.
// Extracted so both sidebarItem (leaf) and sidebarItem (parent) can call it
// without duplicating markup, and child items in .sidebar-children reuse the
// same template rather than a hand-rolled copy.
templ navLink(item NavItem) {
	<a
		class={ "sidebar-item pm7-sidebar-item", templ.KV("active pm7-sidebar-item--active", item.Active) }
		href={ templ.SafeURL(item.URL) }
		aria-label={ tooltipOf(item) }
		style={ "anchor-name: --nav-" + item.ID }
		if item.Active {
			aria-current="page"
		}
	>
		if item.Icon != "" {
			<span class="sidebar-icon">{ item.Icon }</span>
		}
		<span class="sidebar-label">{ item.Label }</span>
		if item.Badge != nil {
			if b := item.Badge(ctx); b != "" {
				<span class="sidebar-count">{ b }</span>
			}
		}
		<span class="sidebar-tooltip" style={ "position-anchor: --nav-" + item.ID }>{ tooltipOf(item) }</span>
	</a>
}

// sidebarItem renders a leaf nav link or a one-level submenu parent.
// Leaf (no Children): delegates directly to navLink.
// Parent (len(Children)>0): wraps navLink in a .sidebar-parent div,
// emits data-has-active-child when any child is active (JS mirrors this guard
// to force the parent expanded regardless of the sb-s collapse cookie), and
// appends a .sidebar-children block that loops direct children via navLink.
// Children-of-children are ignored — one level only (YAGNI).
// Server-side always renders expanded; JS (sb-s cookie) controls collapse.
templ sidebarItem(item NavItem) {
	if len(item.Children) > 0 {
		<div
			class="sidebar-parent"
			if hasActiveChild(item) {
				data-has-active-child="true"
			}
		>
			@navLink(item)
			<div class="sidebar-children">
				for _, child := range item.Children {
					@navLink(child)
				}
			</div>
		</div>
	} else {
		@navLink(item)
	}
}

// LoginIdentifier describes the login form's identity field, letting one
// LoginPage serve both the single-user (HMACAuth, username) and multi-user
// (BcryptTOTPAuth, email) authenticators.
type LoginIdentifier struct {
	Label        string // visible label, e.g. "Username" or "Email"
	Name         string // input id/name, e.g. "username" or "email"
	Type         string // input type, e.g. "text" or "email"
	Autocomplete string // autocomplete hint, e.g. "username" or "email"
}

// LoginPage renders the standalone admin login (no sidebar). It is the framework
// default rendered by auth.HMACAuth when no LoginTempl override is set, so it
// carries its own pm7 design tokens and stays visually consistent with the admin
// chrome (and renders correctly even if pm7.css fails to load). basePath prefixes
// the static-asset and form-action URLs, e.g. "/admin".
templ LoginPage(basePath string, ident LoginIdentifier, errMsg string) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Admin Login</title>
			<link rel="stylesheet" href={ basePath + "/static/pm7.css" }/>
			<style>
				:root{
					--pm7-background:#060b18;--pm7-foreground:#e8edf5;--pm7-muted:#131c31;
					--pm7-muted-foreground:#7b8ba8;--pm7-border:#1e2d4a;--pm7-input:#0c1222;
					--pm7-primary:#3b82f6;--pm7-primary-hover:#2563eb;--pm7-primary-foreground:#fff;
					--pm7-radius:.625rem;
					--bg-deep:#060b18;--bg-surface:#131c31;--accent:#3b82f6;
					--accent-glow:rgba(59,130,246,.15);--text-primary:#e8edf5;
					--text-secondary:#7b8ba8;--border:#1e2d4a;
					--font-sans:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
				}
				*{box-sizing:border-box}
				body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-deep);color:var(--text-primary);font-family:var(--font-sans);font-size:.875rem;padding:1.5rem}
				.login-shell{width:100%;max-width:22rem}
				.login-card{width:100%;padding:2rem;background:var(--bg-surface);border:1px solid var(--border);border-radius:.75rem}
				.login-title{margin:0 0 1.5rem;font-size:1.125rem;font-weight:700;color:var(--text-primary);text-align:center;letter-spacing:.01em}
				.login-error{margin-bottom:1rem;padding:.5rem .75rem;border-radius:.375rem;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.35);color:#fca5a5;font-size:.8125rem;text-align:center}
				.login-field{margin-bottom:1rem}
				.login-field label{display:block;margin-bottom:.375rem;font-size:.8125rem;color:var(--text-secondary)}
				.login-form .pm7-input{width:100%;padding:.5rem .75rem;background:var(--bg-deep);border:1px solid var(--border);border-radius:.5rem;color:var(--text-primary);font-size:.875rem;outline:none;transition:border-color .15s,box-shadow .15s}
				.login-form .pm7-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-glow)}
				.pw-wrap{position:relative}
				.pw-wrap .pm7-input{padding-right:2.75rem}
				.pw-toggle{position:absolute;top:0;right:0;height:100%;width:2.75rem;display:flex;align-items:center;justify-content:center;background:none;border:none;color:var(--text-secondary);cursor:pointer;padding:0}
				.pw-toggle:hover{color:var(--text-primary)}
				.pw-toggle:focus-visible{outline:2px solid var(--accent);outline-offset:-2px;border-radius:.5rem}
				.pw-toggle svg{width:1.125rem;height:1.125rem;display:block}
				.pw-toggle svg[hidden]{display:none}
				.login-submit{width:100%;margin-top:.25rem;padding:.625rem;background:var(--accent);color:#fff;border:none;border-radius:.5rem;font-size:.875rem;font-weight:600;cursor:pointer;transition:background-color .15s}
				.login-submit:hover{background:var(--pm7-primary-hover)}
			</style>
		</head>
		<body>
			<main class="login-shell">
				<div class="pm7-card login-card">
					<div class="pm7-card-content">
						<h1 class="login-title">Admin</h1>
						if errMsg != "" {
							<div class="login-error" role="alert">{ errMsg }</div>
						}
						<form method="POST" action={ templ.SafeURL(basePath + "/login") } class="login-form">
							<div class="login-field">
								<label for={ ident.Name }>{ ident.Label }</label>
								<input id={ ident.Name } name={ ident.Name } type={ ident.Type } autocomplete={ ident.Autocomplete } required autofocus class="pm7-input"/>
							</div>
							<div class="login-field">
								<label for="password">Password</label>
								<div class="pw-wrap">
									<input id="password" name="password" type="password" autocomplete="current-password" required class="pm7-input"/>
									<button type="button" class="pw-toggle" id="pw-toggle" aria-label="Show password" aria-pressed="false">
										<svg class="pw-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"></path>
											<circle cx="12" cy="12" r="3"></circle>
										</svg>
										<svg class="pw-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
											<path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-6.5 0-10-7-10-7a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A10.94 10.94 0 0 1 12 4c6.5 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19M1 1l22 22"></path>
										</svg>
									</button>
								</div>
							</div>
							<button type="submit" class="pm7-button pm7-button--primary login-submit">Sign in</button>
						</form>
					</div>
				</div>
			</main>
			<script src={ basePath + "/static/pm7.js" }></script>
			<script>
				(function(){
					var btn=document.getElementById('pw-toggle');
					if(!btn){return;}
					var inp=document.getElementById('password');
					var eye=btn.querySelector('.pw-eye');
					var off=btn.querySelector('.pw-eye-off');
					btn.addEventListener('click',function(){
						var show=inp.type==='password';
						inp.type=show?'text':'password';
						btn.setAttribute('aria-pressed',show?'true':'false');
						btn.setAttribute('aria-label',show?'Hide password':'Show password');
						if(eye){eye.hidden=show;}
						if(off){off.hidden=!show;}
					});
				})();
			</script>
		</body>
	</html>
}

// assets import used only for the embed.FS reference in shell.go
var _ = assets.StaticFS
