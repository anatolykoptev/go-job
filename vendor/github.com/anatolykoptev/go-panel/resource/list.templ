package resource

import (
	"encoding/json"
	"fmt"
	"net/url"
	"strconv"

	"github.com/anatolykoptev/go-kit/admintable"
)

// listPageData holds all data needed to render a resource list page.
type listPageData struct {
	Resource    Resource
	Rows        []Row
	SortState   admintable.State
	Page        int
	PageSize    int
	Total       int
	TotalPages  int
	BasePath    string
	QueryString string // raw query string for sort link base URL
	// CSRFToken is issued only when the resource can undo a delete
	// (Writer.Restore != nil). It is what the row-level Delete and Вернуть
	// buttons post, and its emptiness is what hides them — so a resource that
	// cannot restore can never render a one-click delete.
	CSRFToken string
	// RestorableID carries the row just deleted from a DETAIL page, so the list
	// can offer the same way back the table row does. Server-rendered rather
	// than client state: it survives a reload and needs no script.
	RestorableID string
	// ActiveView is the resolved Resource.Views key ("" when none declared).
	ActiveView string
	// Selected is the request's raw query values, used ONLY to mark which chip
	// is currently active. Never a source of SQL — see ListQuery's doc.
	Selected url.Values
}

// rowPath builds a per-row URL under this resource: {basePath}/{name}/{id}.
//
// PathEscape because id is a database value. A slug with a slash in it does not
// error, it silently builds a URL pointing somewhere else.
func rowPath(d listPageData, id string, suffix string) string {
	return d.BasePath + "/" + d.Resource.Name + "/" + url.PathEscape(id) + suffix
}

// rowDetailHref is where a row's FIRST cell links to, or "" for no link.
//
// Consumers do not build this. They cannot: a Lister returns rows from a store
// package that has no idea where the panel is mounted, so asking them for a
// URL is asking them to hardcode "/admin" — which is the exact bug CrossLinkCell
// was promoted into the framework to remove, and which every consumer of it
// reproduced until BasePathFrom existed. The framework already assembles this
// path for the Edit link three lines below; it can assemble this one too.
//
// Row.Href still wins, for the case the derivation cannot serve: a detail page
// belonging to a DIFFERENT resource.
//
// EffectiveDetailer rather than `d.Resource.Detailer != nil` because a resource
// that sets only FetchRow HAS a detail route — Register synthesizes the
// Detailer into a copy and mounts that, leaving the original field nil. Reading
// the field directly would leave exactly those resources unlinked, and the
// symptom is invisible: a name that is simply not a link.
func rowDetailHref(d listPageData, row Row) string {
	if row.Href != "" {
		return row.Href
	}
	if row.ID == "" || EffectiveDetailer(d.Resource) == nil {
		return ""
	}
	return rowPath(d, row.ID, "")
}

// chipClass returns the filter-chip class list, adding "active" when value is
// the one currently selected for key. Without this the selected chip renders
// identically to the others: `.filter-chip.active` has existed in styles.templ
// since the chips did, and nothing applied it, so no admin list has ever shown
// which filter is on.
func chipClass(d listPageData, key, value string) string {
	for _, v := range d.Selected[key] {
		if v == value {
			return "filter-chip active"
		}
	}
	return "filter-chip"
}

// viewChipClass returns the chip class for a view key.
func viewChipClass(d listPageData, key string) string {
	if d.ActiveView == key {
		return "filter-chip active"
	}
	return "filter-chip"
}

// viewsLabel is the caption beside the view chips.
func viewsLabel(r Resource) string {
	if r.ViewsLabel != "" {
		return r.ViewsLabel
	}
	return "view"
}

// viewLabel is the chip text for one view, falling back to its key.
func viewLabel(v View) string {
	if v.Label != "" {
		return v.Label
	}
	return v.Key
}

// listPageContent renders the full list page content (page header + filter bar + table + pagination).
// Wrapped by Layout for non-htmx requests; used directly for htmx fragment swap.
templ listPageContent(d listPageData) {
	if d.RestorableID != "" && d.CSRFToken != "" {
		// Rendered server-side rather than raised in JS: it survives a reload,
		// needs no client state, and works under the admin CSP, which drops
		// inline handlers. admin.js only fades it — if that never loads the
		// toast stays, which is the safe direction.
		<div class="undo-toast" data-undo-after="5000" role="status">
			<span>{ d.Resource.Title } deleted</span>
			<form method="POST" action={ templ.SafeURL(d.BasePath + "/" + d.Resource.Name + "/" + d.RestorableID + "/restore") }>
				<input type="hidden" name={ csrfFormField } value={ d.CSRFToken }/>
				<button type="submit" class="row-undo">Вернуть</button>
			</form>
		</div>
	}
	<div class="page-header">
		<div style="display:flex;align-items:center;justify-content:space-between;gap:1rem">
			<div>
				<h2>{ d.Resource.Title }</h2>
				<p>{ strconv.Itoa(d.Total) } total</p>
			</div>
			if d.Resource.Writer != nil {
				<a
					href={ templ.SafeURL(d.BasePath + "/" + d.Resource.Name + "/new") }
					class="pm7-button pm7-button--primary"
					style="text-decoration:none;white-space:nowrap"
				>+ New</a>
			}
		</div>
	</div>
	@filterBar(d)
	@listRowsFragment(d)
}

// listRowsFragment renders only the table + pagination (for htmx row swap).
// It is ALSO embedded in the full page (listPageContent) so the
// #{name}-region swap target exists on first paint — without it the first
// sort/filter/pagination click has no target and htmx silently does nothing.
templ listRowsFragment(d listPageData) {
	<div id={ d.Resource.Name + "-region" }>
		<div class="crm-table-scroll">
			@listTable(d)
		</div>
		@pagination(d)
	</div>
}

// listRowsAppend renders bare <tr> rows for the Load-more beforeend swap,
// plus an out-of-band replacement of the pagination block so the page
// counter and the Load-more link advance with the appended page.
templ listRowsAppend(d listPageData) {
	@listRows(d)
	<div id={ d.Resource.Name + "-pagination" } hx-swap-oob="outerHTML">
		@paginationInner(d)
	</div>
}

// filterBar renders the filter chips for ILike text search and Eq/AnyOf chip selectors.
templ filterBar(d listPageData) {
	if len(d.Resource.Filter.Filters) > 0 || len(d.Resource.Views) > 0 {
		<form
			class="filter-bar"
			hx-get={ d.BasePath + "/" + d.Resource.Name + "/rows" }
			hx-target={ "#" + d.Resource.Name + "-region" }
			hx-push-url="true"
			hx-trigger="change, submit"
		>
			if len(d.Resource.Views) > 0 {
				<div style="display:flex;gap:.25rem;align-items:center">
					<span style="font-family:var(--font-mono);font-size:.625rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em">{ viewsLabel(d.Resource) }</span>
					for _, v := range d.Resource.Views {
						<button
							type="submit"
							name="view"
							value={ v.Key }
							class={ viewChipClass(d, v.Key) }
						>{ viewLabel(v) }</button>
					}
				</div>
			}
			for _, f := range d.Resource.Filter.Filters {
				if len(f.Allowed) > 0 {
					<div style="display:flex;gap:.25rem;align-items:center">
						<span style="font-family:var(--font-mono);font-size:.625rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em">{ f.Key }</span>
						for _, a := range f.Allowed {
							<button
								type="submit"
								name={ f.Key }
								value={ a }
								class={ chipClass(d, f.Key, a) }
							>{ a }</button>
						}
					</div>
				} else {
					<input
						type="search"
						name={ f.Key }
						value={ d.Selected.Get(f.Key) }
						placeholder={ "Search " + f.Key + "..." }
						style="padding:.375rem .625rem;background:var(--bg-deep);border:1px solid var(--border);border-radius:var(--radius);color:var(--text-primary);font-family:var(--font-sans);font-size:.8125rem"
					/>
				}
			}
		</form>
	}
}

// listTable renders the sortable table with headers and rows.
templ listTable(d listPageData) {
	<table class="crm-table" id={ d.Resource.Name + "-table" }>
		<thead>
			<tr>
				for _, col := range d.Resource.Sort.Columns {
					<th style={ colHeaderStyle(col) }>
						if col.Sortable {
							<a
								class={ "crm-th-sort", templ.KV("active", col.Key == d.SortState.Key) }
								href={ templ.SafeURL(sortURL(d, col.Key)) }
								hx-get={ sortURL(d, col.Key) }
								hx-target={ "#" + d.Resource.Name + "-region" }
								hx-swap="outerHTML"
								hx-push-url="true"
							>
								{ col.Label }
								<span class="crm-th-arrow" aria-hidden="true">{ sortArrow(d.SortState, col.Key) }</span>
							</a>
						} else {
							{ col.Label }
						}
					</th>
				}
				if d.Resource.Writer != nil {
					<th style="width:4rem"></th>
				}
			</tr>
		</thead>
		<tbody>
			if len(d.Rows) == 0 {
				<tr>
					<td
						colspan={ listColspan(d) }
						style="text-align:center;color:var(--text-muted);padding:2rem"
					>
						No results
					</td>
				</tr>
			}
			@listRows(d)
		</tbody>
	</table>
}

// listRows renders the data <tr> rows shared by the full table body and the
// Load-more append fragment (parity by construction, edit column included).
templ listRows(d listPageData) {
	for _, row := range d.Rows {
		@listRow(d, row)
	}
}

// listRow renders ONE data row.
//
// Extracted from listRows so the delete handler can swap a single <tr> and get
// markup identical to the full-page render. Two templates that "look the same"
// drift, and the drift shows only in the swapped row — next to its unswapped
// neighbours, which is the one place nobody has a baseline for.
templ listRow(d listPageData, row Row) {
	{{ detailHref := rowDetailHref(d, row) }}
	<tr>
		for i, cell := range row.Cells {
			if i == 0 && detailHref != "" {
				<td style={ colCellStyle(d, i) }>
					// Plain string, never templ.SafeURL: SafeURL is the opt-OUT
					// of templ's URL sanitiser, so casting a consumer-supplied
					// Row.Href to it renders javascript: verbatim in the href.
					<a class="row-name" href={ detailHref }>{ cell.Value }</a>
				</td>
			} else if cell.HTML {
				<td style={ colCellStyle(d, i) }>@templ.Raw(cell.Value)</td>
			} else {
				<td style={ colCellStyle(d, i) }>{ cell.Value }</td>
			}
		}
		if d.Resource.Writer != nil {
			<td style="text-align:right;white-space:nowrap">
				<a
					href={ rowPath(d, row.ID, "/edit") }
					style="font-size:.75rem;color:var(--text-secondary);text-decoration:none"
				>Edit</a>
				if d.Resource.Writer.Restore != nil && d.CSRFToken != "" {
					<button
						type="button"
						class="row-delete"
						hx-post={ d.BasePath + "/" + d.Resource.Name + "/" + row.ID + "/delete" }
						hx-vals={ csrfVals(d.CSRFToken) }
						hx-target="closest tr"
						hx-swap="outerHTML"
						aria-label={ "Delete " + row.ID }
					>Delete</button>
				}
			</td>
		}
	</tr>
}

// deletedRow replaces a row the operator just deleted: dimmed, and offering the
// way back where Delete used to be.
//
// It is rendered ONLY when the resource has a Restore, so this markup can never
// appear for a resource that cannot honour the button it draws. The row is
// removed from the DOM by admin.js after the undo window; if that script fails
// to load the row stays dimmed instead of vanishing, which is the safe
// direction — a stale visible row is recoverable, a silently vanished one is
// indistinguishable from a delete the operator did not intend.
templ deletedRow(d listPageData, id string, label string) {
	<tr class="row-deleted" data-undo-after="5000">
		<td colspan={ listColspanExceptActions(d) } class="row-deleted-label">
			{ label } deleted
		</td>
		<td style="text-align:right;white-space:nowrap">
			<button
				type="button"
				class="row-undo"
				hx-post={ d.BasePath + "/" + d.Resource.Name + "/" + id + "/restore" }
				hx-vals={ csrfVals(d.CSRFToken) }
				hx-target="closest tr"
				hx-swap="outerHTML"
			>Вернуть</button>
		</td>
	</tr>
}

// pagination renders page navigation inside a stable-id wrapper so the
// Load-more OOB swap can replace it (the wrapper renders even on a single
// page — the OOB target must always exist).
templ pagination(d listPageData) {
	<div id={ d.Resource.Name + "-pagination" }>
		@paginationInner(d)
	</div>
}

// paginationInner renders the page links + Load-more; shared by the normal
// render and the OOB replacement in listRowsAppend.
templ paginationInner(d listPageData) {
	if d.TotalPages > 1 {
		<div class="pagination">
			if d.Page > 1 {
				<a
					href={ templ.SafeURL(pageURL(d, d.Page-1)) }
					hx-get={ pageURL(d, d.Page-1) }
					hx-target={ "#" + d.Resource.Name + "-region" }
					hx-swap="outerHTML"
					hx-push-url="true"
					style="padding:.375rem .75rem;border:1px solid var(--border);border-radius:var(--radius);color:var(--text-secondary);text-decoration:none"
				>&larr; Prev</a>
			}
			<span style="padding:.375rem .75rem;color:var(--text-muted);font-family:var(--font-mono);font-size:.8125rem">
				{ fmt.Sprintf("%d / %d", d.Page, d.TotalPages) }
			</span>
			if d.Page < d.TotalPages {
				<a
					href={ templ.SafeURL(pageURL(d, d.Page+1)) }
					hx-get={ pageURL(d, d.Page+1) }
					hx-target={ "#" + d.Resource.Name + "-region" }
					hx-swap="outerHTML"
					hx-push-url="true"
					style="padding:.375rem .75rem;border:1px solid var(--border);border-radius:var(--radius);color:var(--text-secondary);text-decoration:none"
				>Next &rarr;</a>
				<a
					href={ templ.SafeURL(pageURL(d, d.Page+1)) }
					hx-get={ appendURL(d) }
					hx-target={ "#" + d.Resource.Name + "-table tbody" }
					hx-swap="beforeend"
					style="padding:.375rem .75rem;border:1px solid var(--border);border-radius:var(--radius);color:var(--text-secondary);text-decoration:none"
				>Load more &darr;</a>
			}
		</div>
	}
}

// --- helper functions (not components) ---

// listColspan returns the total column count including the optional edit column.
// listColspanExceptActions is listColspan minus the actions column: a deleted
// row's label spans the data columns while its actions cell keeps the undo
// button exactly where the Delete it replaced used to be.
func listColspanExceptActions(d listPageData) string {
	return strconv.Itoa(len(d.Resource.Sort.Columns))
}

// csrfVals renders the token as an hx-vals JSON object. htmx sends it as an
// ordinary form field, so the existing CSRF check on the route applies
// unchanged — this adds an affordance, not an exemption. The field name comes
// from csrfFormField for the same reason the templates do: a literal here
// would 403 silently, which is what a working button looks like.
func csrfVals(token string) string {
	b, err := json.Marshal(map[string]string{csrfFormField: token})
	if err != nil {
		return "{}"
	}
	return string(b)
}

func listColspan(d listPageData) string {
	n := len(d.Resource.Sort.Columns)
	if d.Resource.Writer != nil {
		n++
	}
	return strconv.Itoa(n)
}

func sortURL(d listPageData, colKey string) string {
	dir := "asc"
	if colKey == d.SortState.Key && d.SortState.Dir == admintable.Asc {
		dir = "desc"
	}
	return fmt.Sprintf("%s/%s/rows?sort=%s&dir=%s", d.BasePath, d.Resource.Name, colKey, dir)
}

func sortArrow(st admintable.State, key string) string {
	if key != st.Key {
		return ""
	}
	if st.Dir == admintable.Asc {
		return "▲"
	}
	return "▼"
}

func pageURL(d listPageData, page int) string {
	// Preserve ALL incoming query params (filters, search, etc.) and only
	// override page + sort/dir so clicking Prev/Next on a filtered list
	// does not silently drop the filter.
	vals, _ := url.ParseQuery(d.QueryString)
	// append is a per-request render mode, never a persistent link param:
	// carrying it into Prev/Next region-swap links would make them return
	// bare rows into the region target.
	vals.Del("append")
	vals.Set("page", strconv.Itoa(page))
	if d.SortState.Key != "" {
		vals.Set("sort", d.SortState.Key)
		vals.Set("dir", string(d.SortState.Dir))
	} else {
		// No active sort — remove any stale sort params from the query string.
		vals.Del("sort")
		vals.Del("dir")
	}
	return fmt.Sprintf("%s/%s/rows?%s", d.BasePath, d.Resource.Name, vals.Encode())
}

// appendURL is pageURL for the NEXT page in append render mode (bare rows +
// OOB pagination), used only by the Load-more control.
func appendURL(d listPageData) string {
	return pageURL(d, d.Page+1) + "&append=1"
}

// colHeaderStyle builds the inline style for a <th> element from Column.Width and Column.Align.
// Returns an empty string when neither is set (no style attribute rendered).
func colHeaderStyle(col admintable.Column) string {
	s := ""
	if col.Width != "" {
		s += "width:" + col.Width + ";"
	}
	if col.Align != "" {
		s += "text-align:" + col.Align + ";"
	}
	return s
}

// colCellStyle builds the inline style for a <td> element using the column at index i.
// Out-of-bounds index (extra cells) returns an empty string safely.
func colCellStyle(d listPageData, i int) string {
	return colCellStyleAt(d.Resource.Sort.Columns, i)
}

// colCellStyleAt is colCellStyle over a bare column slice, so the Trash table —
// which renders another resource's columns without that resource's
// listPageData — styles its cells through the SAME code the list uses. Two
// functions drawing "the same" cell drift, and the drift shows only on the page
// nobody has a baseline for.
func colCellStyleAt(cols []admintable.Column, i int) string {
	if i >= len(cols) {
		return ""
	}
	col := cols[i]
	s := ""
	if col.Align != "" {
		s += "text-align:" + col.Align + ";"
	}
	return s
}
