package resource

// detailColAlign builds the inline style for a detail-table <th>/<td> from
// DetailColumn.Align. Mirrors colHeaderStyle in list.templ. An empty Align
// yields an empty style attribute (style=""), which is inert — templ does NOT
// drop it, measured on the rendered output. Only "right"/"center" are expected;
// anything else passes through verbatim, matching the list page's permissive
// behaviour. Align comes from a Spec literal in consumer CODE, never from a
// request, which is why verbatim is acceptable here and is not for a cell.
func detailColAlign(align string) string {
	if align == "" {
		return ""
	}
	return "text-align:" + align + ";"
}

// detailPageData holds all data needed to render a resource detail (Show) page.
type detailPageData struct {
	Resource  Resource
	ID        string
	Sections  []DetailSection
	BasePath  string
	CSRFToken string // empty when Writer.Delete is nil
}

// detailPageContent renders the full detail page content (back link + sections).
// Wrapped by Layout for all detail requests (detail pages are always full-page — no htmx fragment path).
templ detailPageContent(d detailPageData) {
	<div class="page-header">
		<a
			href={ templ.SafeURL(d.BasePath + "/" + d.Resource.Name) }
			style="display:inline-flex;align-items:center;gap:.375rem;font-size:.8125rem;color:var(--text-secondary);text-decoration:none;margin-bottom:.75rem"
		>
			<span aria-hidden="true">&#8592;</span>
			Back to { d.Resource.Title }
		</a>
	</div>
	<div class="detail-page">
		if len(d.Sections) == 0 {
			<p style="color:var(--text-muted);font-family:var(--font-mono);font-size:.8125rem">No detail available.</p>
		}
		for _, section := range d.Sections {
			@detailSection(section)
		}
		if d.CSRFToken != "" {
			<form
				method="POST"
				action={ templ.SafeURL(d.BasePath + "/" + d.Resource.Name + "/" + d.ID + "/delete") }
				style="margin-top:1.5rem"
				data-confirm={ "Delete this " + d.Resource.Title + "? This cannot be undone." }
			>
				<input type="hidden" name={ csrfFormField } value={ d.CSRFToken }/>
				<button type="submit" style="background:var(--danger,#dc2626);color:#fff;border:none;padding:.5rem 1rem;border-radius:.375rem;cursor:pointer;font-size:.8125rem">
					Delete
				</button>
			</form>
		}
	</div>
}

// detailSection renders one DetailSection as a card.
//
// Precedence: RawHTML wins outright (neither Items nor Table render when it is
// set). Otherwise Items render first — the label/value summary — and then the
// Table, so a section may carry a summary line above its tabular data. Both
// being set on one section is the intended shape, not a mistake.
templ detailSection(s DetailSection) {
	<div class="detail-section">
		if s.Title != "" {
			<div class="detail-section-title">{ s.Title }</div>
		}
		if s.RawHTML != "" {
			@templ.Raw(s.RawHTML)
		} else {
			if len(s.Items) > 0 {
				<dl class="detail-items">
					for _, item := range s.Items {
						<div class="detail-item">
							<dt class="detail-item-label">{ item.Label }</dt>
							if item.HTML {
								<dd class="detail-item-value">@templ.Raw(item.Value)</dd>
							} else {
								<dd class="detail-item-value">{ item.Value }</dd>
							}
						</div>
					}
				</dl>
			}
			if len(s.Table.Columns) > 0 {
				<div class="crm-table-scroll">
					<table class="crm-table crm-table--static">
						<thead>
							<tr>
								for _, col := range s.Table.Columns {
									<th style={ detailColAlign(col.Align) }>{ col.Label }</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, row := range s.Table.Rows {
								<tr>
									for i := 0; i < len(s.Table.Columns); i++ {
										if i < len(row) {
											<td style={ detailColAlign(s.Table.Columns[i].Align) }>
												if row[i].Href != "" {
													<a href={ row[i].Href }>{ row[i].Value }</a>
												} else {
													{ row[i].Value }
												}
											</td>
										} else {
											<td style={ detailColAlign(s.Table.Columns[i].Align) }></td>
										}
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	</div>
}
