[Unit]
Description=go_job — Job & Freelance Search MCP
After=network.target

[Service]
Type=simple
ExecStart=/home/krolik/go_job/bin/go_job
EnvironmentFile=/home/krolik/go-search/deploy/go-search.env
EnvironmentFile=/home/krolik/krolik-server/.env
EnvironmentFile=/home/krolik/go_job/deploy/go_job.env
Environment=LLM_API_BASE=http://127.0.0.1:8317/v1
Environment=LLM_MODEL=gemini-3.1-flash-lite-preview
Environment=MCP_PORT=8891
Environment=MAX_FETCH_URLS=8
Environment=MAX_CONTENT_CHARS=6000
Environment=REDIS_URL=redis://127.0.0.1:6379/2
Environment=CACHE_TTL=900
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
