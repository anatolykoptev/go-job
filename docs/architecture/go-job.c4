specification {
  element person { style { shape: person } }
  element system
  element container
}

model {
  user = person "User" "Caller / consumer."

  go_job = system "go-job" {
    description '''
      Job, remote and freelance search MCP server. Exposes 32 MCP tools across
      17 source connectors, plus a persistent hunt store (Postgres) that keeps the
      longitudinal record — what was seen, rejected, applied to, and how it went.

      TODO: expand into containers + components (engine, jobserver, hunt, adminui,
      pdfrender). See docs/architecture/principles.md for the decision model.
    '''

    main = container "go-job" {
      description "Main container. Tech: Go, port :8891."
      technology "Go"
      icon tech:go
    }
  }

  user -> go_job.main "calls"
}

views {
  view index {
    title "Top level"
    include user, go_job, go_job.main
    autoLayout LeftRight
  }
}
